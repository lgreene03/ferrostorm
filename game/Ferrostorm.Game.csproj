<Project Sdk="Godot.NET.Sdk/4.7.0">
  <!-- Requires a Godot 4.7.x .NET editor. Godot.NET.Sdk is NOT fetched from
       nuget.org: the repo's nuget.config clears every package source by design,
       and the editor SHIPS the SDK it wants in GodotSharp/Tools/nupkgs, so that
       directory is the source. CI unpacks the editor and points NuGet at it.

       This comment used to end "this project is therefore excluded from CI".
       It no longer is - the client-harness job builds it and drives the real
       battle scene headless on every push. The presentation CONTRACT it
       consumes is still tested by the runner's spectate mode as well. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../sim/Ferrostorm.Sim/Ferrostorm.Sim.csproj" />
    <ProjectReference Include="../sim/Ferrostorm.Presentation/Ferrostorm.Presentation.csproj" />
    <!-- TICKET-P5-SET-01: the LAN screen drives the SAME Relay and
         LockstepClient the runner's lan mode soaks. A second copy of the wire
         format living in the client is how the two silently stop agreeing. -->
    <ProjectReference Include="../sim/Ferrostorm.Net/Ferrostorm.Net.csproj" />
  </ItemGroup>
</Project>
