# --- Mission 03: Hold the Line ---
# The gap is yours. Keep it.
structure 0 1 14 20
structure 0 3 14 26
structure 0 2 10 28
structure 0 5 26 22
structure 0 5 26 26
unit 0 4 16 28
unit 0 1 24 20
unit 0 1 24 28
unit 0 2 22 22
unit 0 2 22 26
# P7-9a: the yard and the opening treasury are declared HERE, not in a
# per-mission case in the client. Missions 04 to 06 have always done this;
# 01 and 03 got theirs from `switch (setup.MissionIndex)` in SkirmishLive,
# which is a rule keyed on WHICH mission this is rather than on what the
# mission says, so every new mission needed a C# edit and a matching one in
# the gate, and a mission whose author forgot was silently a mission with no
# base. Two mechanisms for one thing is the duplication this phase keeps
# finding; this is the second one retired.
# No yard line here: mission 03 declares its own base above, so the only
# thing the switch was still supplying was the treasury.
trigger elapsed 0 -> grant 0 4000
trigger elapsed 300 -> message first_wave
trigger elapsed 300 -> spawn 1 2 58 22 4
trigger elapsed 300 -> assault 1 26 24
trigger elapsed 1400 -> message second_wave
trigger elapsed 1400 -> spawn 1 9 58 20 2
trigger elapsed 1400 -> spawn 1 3 58 26 3
trigger elapsed 1400 -> assault 1 26 24
trigger elapsed 2800 -> message last_wave
trigger elapsed 2800 -> spawn 1 9 58 18 3
trigger elapsed 2800 -> spawn 1 2 58 24 4
trigger elapsed 2800 -> assault 1 26 24
trigger elapsed 4200 -> message the_line_held
trigger elapsed 4200 -> win 0
# Q016 answered: option 1, defeat when the player holds nothing that counts as
# being in the game. 'rules noshortgame' above is load-bearing and cannot
# simply be dropped - player 1 owns no structures at all, so short game would
# eliminate the ATTACKER on tick 0 and hand the player an instant win. So the
# mission states its own defeat, and 'eliminated' asks the same predicate the
# short-game rule asks rather than inventing a second answer.
# Written BELOW the win: on the tick where both come true the player has held
# the line, and file order is what decides that.
trigger eliminated 0 -> message the_line_broke
trigger eliminated 0 -> win 1
